function pct(){return state.attempts?Math.round(state.correct/state.attempts*100):0}
function show(name){screen=name;document.querySelectorAll(".screen").forEach(x=>x.classList.toggle("active",x.id===name));document.querySelectorAll(".nav button").forEach(x=>x.classList.toggle("active",x.dataset.screen===name));render()}
function home(){let p=plan(),d=daysLeft();$("home").innerHTML=`<div class="hero"><div class="eyebrow">MY TOEIC GOAL</div><div class="score">${state.goal}<span style="font-size:15px">점 목표</span></div><div class="row small"><span>현재 예상 ${state.current}점</span><span>${d===null?"시험일 미설정":`시험까지 ${d}일`}</span></div><div class="progress"><i style="width:${Math.min(100,state.current/state.goal*100)}%"></i></div><p class="small muted">점수는 학습 계획을 위한 참고값이며 실제 시험 점수를 보장하지 않습니다.</p></div><div class="row" style="margin:17px 0 10px"><b>오늘의 학습 계획</b><button class="btn soft" onclick="show('settings')">계획 수정</button></div><div class="grid"><div class="metric"><span class="small muted">신규 단어</span><strong>${p.per}개</strong><span class="small muted">하루 권장량</span></div><div class="metric"><span class="small muted">복습 단어</span><strong>${p.review}개</strong><span class="small muted">하루 권장량</span></div><div class="metric"><span class="small muted">Part 5</span><strong>${p.part}문제</strong><span class="small muted">하루 권장량</span></div><div class="metric"><span class="small muted">빈출 구문</span><strong>${p.phrases}개</strong><span class="small muted">하루 권장량</span></div></div><div class="card" style="margin-top:12px"><div class="row"><b>단어 학습 현황</b><b>${learned()} / ${WORDS.length}</b></div><div class="progress"><i style="width:${learned()/WORDS.length*100}%"></i></div><p class="small muted">반복 복습을 통해 암기 단계가 올라갑니다.</p><div class="grid"><button class="btn primary" onclick="startWords('en')">단어 학습 시작</button><button class="btn" onclick="startPart()">Part 5 시작</button></div></div><div class="grid"><div class="metric"><span class="small muted">누적 풀이</span><strong>${state.attempts}</strong></div><div class="metric"><span class="small muted">정답률</span><strong>${pct()}%</strong></div></div>`}
function settings(){let s=$("settings");s.innerHTML=`<h2 class="section-title">나의 학습 계획</h2><div class="card"><div class="field"><label>목표 TOEIC 점수</label><select id="goal">${[500,550,600,650,700,750,800,850,900,950,990].map(x=>`<option ${state.goal==x?"selected":""}>${x}</option>`).join("")}</select></div><div class="field"><label>현재 예상 점수</label><input id="current" type="number" min="10" max="990" value="${state.current}"></div><div class="field"><label>시험 예정일</label><input id="date" type="date" value="${state.date}"></div><div class="field"><label>하루 학습 가능 시간 (분)</label><input id="minutes" type="number" min="10" max="600" value="${state.minutes}"></div><div class="field"><label>희망 신규 단어 수 (0이면 자동)</label><input id="daily" type="number" min="0" max="100" value="${state.daily}"></div><div class="field"><label>현재 어휘 수준</label><select id="level">${["기초","중급","고급"].map(x=>`<option ${state.level===x?"selected":""}>${x}</option>`).join("")}</select></div><button class="btn primary full" onclick="saveSettings()">학습 계획 저장</button></div><div class="card"><b>콘텐츠 및 데이터 안내</b><p class="small muted">현재 포함된 20개 단어와 12개 Part 5 문제는 초기 학습용 자체 제작 콘텐츠입니다. 최근 4개년 전체 기출 빈도를 검증한 데이터가 아닙니다. 학습 데이터는 이 기기의 브라우저 저장 공간에 저장됩니다.</p><button class="btn full" onclick="exportData()">학습 데이터 백업 내보내기</button><label class="btn full" style="display:block;text-align:center;margin-top:8px">백업 파일 불러오기<input type="file" accept="application/json" onchange="importData(event)" hidden></label><button class="btn full" style="margin-top:8px;color:#b42332" onclick="resetData()">모든 학습 기록 초기화</button></div>`}
function saveSettings(){let goal=+$("goal").value,current=+$("current").value;if(goal<10||goal>990||current<10||current>990){toast("점수를 10~990 사이로 입력하세요.");return}state.goal=goal;state.current=current;state.date=$("date").value;state.minutes=Math.max(10,+$("minutes").value||60);state.daily=Math.max(0,+$("daily").value||0);state.level=$("level").value;persist();toast("학습 계획을 저장했습니다.");show("home")}
function startWords(mode,list=WORDS){deck=[...list].sort(()=>Math.random()-.5).slice(0,Math.min(10,list.length));deckIndex=0;deckMode=mode;deckResult=null;phraseMode=false;show("words")}
function startPhrases(){phraseMode=true;deckIndex=0;show("words")}
function wordScreen(){let el=$("words");if(phraseMode){let x=PHRASES[deckIndex];el.innerHTML=`<div class="row"><h2 class="section-title">빈출 구문</h2><span class="tag">${deckIndex+1}/${PHRASES.length}</span></div><div class="card"><div class="word" style="font-size:25px">${x[0]}</div><p>${x[1]}</p><p class="small muted">${x[2]}</p><div class="row"><button class="btn" onclick="deckIndex=Math.max(0,deckIndex-1);wordScreen()">이전</button><button class="btn primary" onclick="if(deckIndex<PHRASES.length-1){deckIndex++;wordScreen()}else{phraseMode=false;wordScreen()}">다음</button></div></div>`;return}
if(!deck.length){el.innerHTML=`<h2 class="section-title">단어장 학습</h2><div class="card"><p class="muted small">학습 유형을 선택하세요.</p><button class="btn full" onclick="startWords('en')">영단어 → 뜻 선택</button><button class="btn full" style="margin-top:8px" onclick="startWords('ko')">뜻 → 영단어 선택</button><button class="btn full" style="margin-top:8px" onclick="startWords('typing')">뜻 보고 직접 입력</button><button class="btn full" style="margin-top:8px" onclick="startPhrases()">빈출 구문 학습</button><p class="small muted">등록 단어 ${WORDS.length}개 · 내 보관 단어 ${state.saved.length}개</p></div>`;return}
if(deckIndex>=deck.length){el.innerHTML=`<div class="card" style="text-align:center;padding:35px 18px"><h2>학습 완료!</h2><div class="score">${deck.length}개</div><p class="muted">이번 학습을 마쳤습니다.</p><button class="btn primary full" onclick="deck=[];wordScreen()">단어 메뉴로</button></div>`;return}
let w=deck[deckIndex],saved=state.saved.includes(w.w),opts=[...WORDS.filter(x=>x.w!==w.w).sort(()=>Math.random()-.5).slice(0,3),w].sort(()=>Math.random()-.5);
el.innerHTML=`<div class="row"><h2 class="section-title">단어 학습</h2><span class="tag">${deckIndex+1} / ${deck.length}</span></div><div class="progress"><i style="width:${(deckIndex+1)/deck.length*100}%"></i></div><div class="card" style="margin-top:12px"><div class="row"><span class="tag">${w.lv} · ${w.topic}</span><button class="btn" onclick="speak('${w.w}')">🔊 발음</button></div><div class="word">${deckMode==="ko"?w.m:w.w}</div><div class="muted small">${deckMode==="ko"?"한국어 뜻":"발음기호 "+w.ipa+" · "+w.p}</div>${deckMode==="typing"?`<input id="typed" class="answer-input" style="margin-top:16px" placeholder="영단어를 입력하세요"><button class="btn primary full" style="margin-top:8px" onclick="checkTyped()">정답 확인</button>`:opts.map((x,i)=>`<button class="choice" onclick="answerWord('${x.w}')">${i+1}. ${deckMode==="ko"?x.w:x.m}</button>`).join("")}${deckResult!==null?`<div class="feedback ${deckResult?"ok":"no"}"><b>${deckResult?"✓ 정답":"✕ 오답"}</b><br>${w.w} — ${w.m}<br>${w.phrase}<br>${w.ex}<br>${w.tr}</div>`:""}<div class="grid" style="margin-top:12px"><button class="btn" onclick="toggleSave('${w.w}')">${saved?"★ 보관됨":"☆ 보관하기"}</button>${deckResult!==null?`<button class="btn primary" onclick="nextWord()">다음 단어 →</button>`:""}</div></div>`}
function record(ok){state.attempts++;if(ok)state.correct++;state.history.push({date:new Date().toISOString().slice(0,10),ok});persist()}
function answerWord(v){if(deckResult!==null)return;let w=deck[deckIndex],ok=v===w.w;deckResult=ok;record(ok);let s=state.wordStats[w.w]||{stage:0,correct:0,wrong:0};if(ok){s.correct++;s.stage=Math.min(3,s.stage+1);if(state.wrongWords[w.w]){state.wrongWords[w.w].streak=(state.wrongWords[w.w].streak||0)+1;if(state.wrongWords[w.w].streak>=3)delete state.wrongWords[w.w]}}else{s.wrong++;s.stage=Math.max(0,s.stage-1);let z=state.wrongWords[w.w]||{count:0,streak:0};z.count++;z.streak=0;state.wrongWords[w.w]=z}state.wordStats[w.w]=s;persist();wordScreen()}
function checkTyped(){let w=deck[deckIndex];answerWord($("typed").value.trim().toLowerCase())}
function nextWord(){deckIndex++;deckResult=null;wordScreen()}
function toggleSave(w){if(state.saved.includes(w))state.saved=state.saved.filter(x=>x!==w);else state.saved.push(w);persist();wordScreen();toast("보관함을 업데이트했습니다.")}
function speak(w){if(!("speechSynthesis"in window)){toast("이 기기에서 음성 재생을 지원하지 않습니다.");return}speechSynthesis.cancel();let u=new SpeechSynthesisUtterance(w);u.lang="en-US";u.rate=.86;speechSynthesis.speak(u)}
function startPart(list=PART){partDeck=[...list].sort(()=>Math.random()-.5);partIndex=0;partResult=null;show("part5")}
function partScreen(){let el=$("part5");if(!partDeck.length){el.innerHTML=`<h2 class="section-title">Part 5 Training</h2><div class="card"><div class="score">Part 5</div><p class="muted small">문법 및 어휘 문장 완성 연습 · 자체 제작 문제 ${PART.length}개</p><button class="btn primary full" onclick="startPart()">문제 풀이 시작</button></div>`;return}if(partIndex>=partDeck.length){el.innerHTML=`<div class="card" style="text-align:center;padding:35px 18px"><h2>Part 5 학습 완료</h2><div class="score">${partDeck.filter(x=>x.ok).length}/${partDeck.length}</div><button class="btn primary full" onclick="partDeck=[];partScreen()">메뉴로 돌아가기</button></div>`;return}let q=partDeck[partIndex];el.innerHTML=`<div class="row"><h2 class="section-title">Part 5</h2><span class="tag">${partIndex+1} / ${partDeck.length}</span></div><div class="progress"><i style="width:${(partIndex+1)/partDeck.length*100}%"></i></div><div class="card" style="margin-top:12px"><span class="tag">${q.t}</span><p style="font-size:18px;font-weight:750;line-height:1.7;margin:22px 0">${q.q.replace("_____","<u>_______</u>")}</p>${q.a.map((a,i)=>`<button class="choice ${partResult!==null&&i===q.c?"correct":""} ${partResult===i&&i!==q.c?"wrong":""}" ${partResult!==null?"disabled":""} onclick="answerPart(${i})">${i+1}. ${a}</button>`).join("")}${partResult!==null?`<div class="feedback ${partResult===q.c?"ok":"no"}"><b>${partResult===q.c?"✓ 정답":"✕ 오답"}</b><br>정답: ${q.a[q.c]}<br>${q.tr}<br><b>해설</b> ${q.e}</div><button class="btn primary full" style="margin-top:12px" onclick="nextPart()">다음 문제 →</button>`:""}</div>`}
function answerPart(i){if(partResult!==null)return;let q=partDeck[partIndex];partResult=i;q.ok=i===q.c;record(q.ok);if(!q.ok){let k=PART.indexOf(q),z=state.wrongPart[k]||{count:0};z.count++;state.wrongPart[k]=z}persist();partScreen()}
function nextPart(){partIndex++;partResult=null;partScreen()}
function reviewScreen(){let el=$("review"),ww=Object.entries(state.wrongWords),wp=Object.entries(state.wrongPart),sv=state.saved;el.innerHTML=`<h2 class="section-title">오답 및 개인 보관함</h2><div class="grid"><div class="metric"><span class="small muted">단어 오답</span><strong>${ww.length}</strong></div><div class="metric"><span class="small muted">Part 5 오답</span><strong>${wp.length}</strong></div></div><div class="card" style="margin-top:12px"><div class="row"><b>단어 오답</b><button class="btn soft" onclick="reviewWords()">다시 풀기</button></div>${ww.length?ww.map(([k,v])=>`<div class="listitem row"><div><b>${k}</b><div class="small muted">${WORDS.find(x=>x.w===k)?.m||""} · 오답 ${v.count}회</div></div></div>`).join(""):'<p class="small muted">단어 오답이 없습니다.</p>'}</div><div class="card"><div class="row"><b>Part 5 오답</b><button class="btn soft" onclick="reviewPart()">다시 풀기</button></div>${wp.length?wp.map(([k,v])=>`<div class="listitem"><div class="small">${PART[+k]?.q||""}</div><div class="small muted">오답 ${v.count}회</div></div>`).join(""):'<p class="small muted">Part 5 오답이 없습니다.</p>'}</div><div class="card"><div class="row"><b>내 단어 보관함</b><span class="tag">${sv.length}개</span></div>${sv.length?sv.map(k=>`<div class="listitem row"><div><b>${k}</b><div class="small muted">${WORDS.find(x=>x.w===k)?.m||""}</div></div><button class="btn" onclick="removeSaved('${k}')">삭제</button></div>`).join(""):'<p class="small muted">보관한 단어가 없습니다.</p>'}<button class="btn primary full" style="margin-top:12px" onclick="savedStudy()">보관 단어 학습</button></div>`}
function reviewWords(){let list=Object.keys(state.wrongWords).map(k=>WORDS.find(x=>x.w===k)).filter(Boolean);if(!list.length){toast("복습할 단어가 없습니다.");return}startWords("en",list)}
function reviewPart(){let list=Object.keys(state.wrongPart).map(k=>PART[+k]).filter(Boolean);if(!list.length){toast("복습할 문제가 없습니다.");return}startPart(list)}
function savedStudy(){let list=state.saved.map(k=>WORDS.find(x=>x.w===k)).filter(Boolean);if(!list.length){toast("보관한 단어가 없습니다.");return}startWords("en",list)}
function removeSaved(w){state.saved=state.saved.filter(x=>x!==w);persist();reviewScreen()}
function exportData(){let blob=new Blob([JSON.stringify(state,null,2)],{type:"application/json"}),a=document.createElement("a");a.href=URL.createObjectURL(blob);a.download="toeic-master-backup.json";a.click();URL.revokeObjectURL(a.href)}
function importData(e){let f=e.target.files[0];if(!f)return;let r=new FileReader();r.onload=()=>{try{let x=JSON.parse(r.result);state={...DEFAULT,...x};persist();toast("백업을 불러왔습니다.");show("home")}catch(err){toast("백업 파일을 읽지 못했습니다.")}};r.readAsText(f)}
function resetData(){if(confirm("학습 기록과 보관함을 모두 초기화할까요?")){state={...DEFAULT};persist();show("home")}}
function render(){if(screen==="home")home();if(screen==="settings")settings();if(screen==="words")wordScreen();if(screen==="part5")partScreen();if(screen==="review")reviewScreen()}
document.querySelectorAll(".nav button").forEach(b=>b.addEventListener("click",()=>show(b.dataset.screen)));
if("serviceWorker"in navigator && location.protocol.startsWith("http"))navigator.serviceWorker.register("./service-worker.js").catch(()=>{});
render();
</script>
